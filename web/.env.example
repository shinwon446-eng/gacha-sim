# ── GACHAFLIX 운영 환경 변수 (정적 export 빌드 시 인라인됨) ──
# 백엔드 API — 있으면 live 모드 (입금 주소 발급 · 입금 확인 · 출금 브로드캐스트 · 운송장 · 피드)
NEXT_PUBLIC_API_BASE=
# 플랫폼 전용 입금 지갑 — 운영자가 실제로 통제하는 주소만. 비어 있으면 화면에 주소를 표시하지 않는다.
NEXT_PUBLIC_DEPOSIT_TRC20=
NEXT_PUBLIC_DEPOSIT_BEP20=
NEXT_PUBLIC_DEPOSIT_ERC20=
# 준비금 지갑(선택)
NEXT_PUBLIC_RESERVE_ADDRESS=
NEXT_PUBLIC_RESERVE_NETWORK=TRC20
# 카드 결제 PG — 키가 있어야 결제 버튼이 열린다 (Stripe: 글로벌, PortOne: KRW)
NEXT_PUBLIC_STRIPE_PK=
NEXT_PUBLIC_PORTONE_STORE_ID=
